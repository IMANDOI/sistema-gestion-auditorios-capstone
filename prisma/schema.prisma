// Prisma Schema for Sistema Autónomo de Gestión Operativa de Auditorios
// Compatible with SQLite locally and PostgreSQL (Neon Cloud) in production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("PROFESSOR") // OWNER, IT_ADMIN, IT_SERVICE, ASSISTANT, PROFESSOR, STUDENT
  department    String?
  phone         String?
  priorityScore Int       @default(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reservas          Reserva[]
  horasRegistradas  RegistroHorasTI[]
  auditorias        RegistroAuditoria[]
}

model Auditorio {
  id             String                  @id @default(cuid())
  name           String
  slug           String                  @unique
  capacity       Int                     @default(120)
  location       String
  description    String?
  isActive       Boolean                 @default(true)
  status         String                  @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, PARTIAL_RESTRICTION
  createdAt      DateTime                @default(now())

  reservas       Reserva[]
  mantenimientos RegistroMantenimiento[]
}

model Reserva {
  id                   String    @id @default(cuid())
  title                String
  description          String?
  startTime            DateTime
  endTime              DateTime
  status               String    @default("PENDING") // PENDING, APPROVED, POSTPONED, REJECTED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW
  qrToken              String?   @unique
  attendeesEstimate    Int       @default(30)
  requiresCleaning     Boolean   @default(true)
  requiresGuardia      Boolean   @default(true)
  notes                String?
  rejectionReason      String?
  priorityScoreApplied Int       @default(100)

  // Operational validation and IT hours
  checkInTime          DateTime?
  checkedInBy          String?
  checkoutTime         DateTime?
  checkedOutBy         String?
  reviewedBy           String?
  reviewedAt           DateTime?

  userId               String
  user                 User      @relation(fields: [userId], references: [id])

  auditorioId          String
  auditorio            Auditorio @relation(fields: [auditorioId], references: [id])

  equipamientos        ReservaEquipamiento[]
  horasTI              RegistroHorasTI[]
  encuesta             EncuestaSatisfaccion?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Equipamiento {
  id             String                  @id @default(cuid())
  name           String
  category       String                  // AUDIO, PROJECTION, COMPUTING, FURNITURE, HVAC, OTHER
  serialNumber   String?                 @unique
  status         String                  @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE, DECOMMISSIONED
  totalQty       Int                     @default(1)
  availableQty   Int                     @default(1)
  createdAt      DateTime                @default(now())

  reservas       ReservaEquipamiento[]
  mantenimientos RegistroMantenimiento[]
}

model ReservaEquipamiento {
  id             String       @id @default(cuid())
  reservaId      String
  reserva        Reserva      @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  equipamientoId String
  equipamiento   Equipamiento @relation(fields: [equipamientoId], references: [id])
  quantity       Int          @default(1)
  delivered      Boolean      @default(false)
  returned       Boolean      @default(false)
  notes          String?
}

model RegistroHorasTI {
  id              String   @id @default(cuid())
  reservaId       String
  reserva         Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tecnicoId       String
  tecnico         User     @relation(fields: [tecnicoId], references: [id])
  minutesDuration Int
  hoursDecimal    Float
  notes           String?
  createdAt       DateTime @default(now())
}

model EncuestaSatisfaccion {
  id              String   @id @default(cuid())
  reservaId       String   @unique
  reserva         Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  ratingOverall   Int      // 1 to 5 stars
  ratingEquipment Int      // 1 to 5 stars
  ratingSupport   Int      // 1 to 5 stars
  feedbackComment String?
  npsCategory     String   // PROMOTER (9-10/5), PASSIVE (7-8/4), DETRACTOR (1-6/1-3)
  createdAt       DateTime @default(now())
}

model SuscripcionArea {
  id         String   @id @default(cuid())
  name       String
  email      String
  department String   // ASEO, GUARDIA, TI, COORDINACION
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model RegistroAuditoria {
  id        String   @id @default(cuid())
  action    String   // RESERVATION_CREATED, APPROVED, CHECK_IN, CHECK_OUT, NO_SHOW, CANCELLED, MANTENIMIENTO_REGISTRADO, etc.
  entity    String   // Reserva, Equipamiento, User, Auditorio, Mantenimiento
  entityId  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())
}

model RegistroMantenimiento {
  id                 String        @id @default(cuid())
  type               String        // PREVENTIVO, CORRECTIVO, CALIBRACION, MEJORA, DANIO_REPORTE
  targetType         String        // AUDITORIO, EQUIPAMIENTO
  auditorioId        String?
  auditorio          Auditorio?    @relation(fields: [auditorioId], references: [id], onDelete: Cascade)
  equipamientoId     String?
  equipamiento       Equipamiento? @relation(fields: [equipamientoId], references: [id], onDelete: Cascade)
  title              String
  description        String
  severity           String        @default("MEDIA") // BAJA, MEDIA, ALTA, CRITICA
  status             String        @default("EN_MANTENCION") // PROGRAMADO, EN_MANTENCION, ESPERANDO_REPUESTO, RESUELTO
  reportedBy         String
  technicianAssigned String?       @default("Servicio Técnico TI Central")
  costEstimate       Float?        @default(0)
  startDate          DateTime      @default(now())
  expectedEndDate    DateTime?
  resolvedDate       DateTime?
  resolutionNotes    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

